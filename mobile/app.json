{
  "expo": {
    "name": "Far From Fries",
    "slug": "far-from-fries",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "farfromfries",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.farfromfries",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:farfromfries.app"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Far From Fries uses your location to measure how far you are from the nearest McDonald's. Your exact location is never shown to friends.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.farfromfries",
      "adaptiveIcon": {
        "backgroundColor": "#0F5257",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "ACCESS_BACKGROUND_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F5257",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Far From Fries uses your location to measure how far you are from the nearest McDonald's. Your exact location is never shown to friends.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F2A900"
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "owner": "blangholzs-team",
    "extra": {
      "eas": {
        "projectId": "90f8bd7f-12ee-4197-b52b-afc520caa2cd"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/90f8bd7f-12ee-4197-b52b-afc520caa2cd"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
