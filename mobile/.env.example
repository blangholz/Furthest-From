# Copy to .env.local and fill in. Leave the Supabase lines empty to run in demo mode.
# These are public client values (the anon key is safe in the app). Never put the
# service role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_WEB_URL=https://farfromfries.app
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
